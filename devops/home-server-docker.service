[Unit]
Description=Run Docker Containers At Startup
After=network.target
ConditionPathExists=/root/repos/home-server/devops/start-services-on-startup.sh

[Service]
Type=oneshot
ExecStart=/root/repos/home-server/devops/start-services-on-startup.sh
User=root
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
